# Copy to .env.production only on the server and replace every placeholder.
# Never commit the resulting .env.production file.

APP_DOMAIN=example.it
API_DOMAIN=api.example.it
ACME_EMAIL=admin@example.it
IMAGE_TAG=local

POSTGRES_DB=chiron
POSTGRES_USER=chiron
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+psycopg://chiron:replace-with-a-random-hex-password@db:5432/chiron

APP_ENV=production
APP_NAME=MAKA API
APP_CORS_ORIGINS=https://example.it
APP_SECRET_KEY=replace-with-at-least-64-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_TOKEN_ISSUER=maka-api
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
WAITLIST_ENABLED=false
APP_TIMEZONE=Europe/Rome
BOOKING_HORIZON_DAYS=28
COURSE_UPLOAD_DIR=/app/uploads

VITE_API_BASE_URL=https://api.example.it
