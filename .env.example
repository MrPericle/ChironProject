# Shared local development settings.
# Copy this file to .env when using docker compose locally.

POSTGRES_DB=chiron
POSTGRES_USER=chiron
POSTGRES_PASSWORD=chiron_dev_password
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173

DATABASE_URL=postgresql+psycopg://chiron:chiron_dev_password@db:5432/chiron
APP_ENV=development
APP_NAME=Chiron Project
API_DOCS_ENABLED=true
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_SECRET_KEY=dev-only-change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
WAITLIST_ENABLED=false
APP_TIMEZONE=Europe/Rome
BOOKING_HORIZON_DAYS=28
COURSE_UPLOAD_DIR=/app/uploads
EMAIL_DELIVERY_MODE=console
EMAIL_FROM_ADDRESS=noreply@localhost
EMAIL_FROM_NAME=MAKA
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
RESEND_API_KEY=
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

VITE_API_BASE_URL=http://localhost:8000
